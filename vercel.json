{
  "version": 2,
  "rewrites": [
    {
      "source": "/r/:slug",
      "destination": "/api/r?slug=:slug"
    },
    {
      "source": "/r/:slug/",
      "destination": "/api/r?slug=:slug"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/r"
    },
    {
      "source": "/r",
      "destination": "/api/r"
    },
    {
      "source": "/nfc/:id",
      "destination": "/api/nfc?id=:id"
    },
    {
      "source": "/nfc/(.*)",
      "destination": "/api/nfc"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
