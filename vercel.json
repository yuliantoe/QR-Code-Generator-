{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/nfc/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/((?!api/|r/|nfc/).*)",
      "destination": "/index.html"
    }
  ]
}
