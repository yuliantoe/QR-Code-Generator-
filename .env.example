# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# VERCEL POSTGRES / DATABASE CONNECTION
# Vercel automatically sets POSTGRES_URL when you connect Vercel Postgres in your Vercel project Storage tab.
# You can also use DATABASE_URL from Neon, Supabase, or any PostgreSQL provider.
POSTGRES_URL="postgres://default:password@ep-example.pooler.region.postgres.vercel-storage.com:5432/verceldb?sslmode=require"
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# VERCEL KV / UPSTASH REDIS REST (Alternatif penyimpanan persisten serverless jika tanpa Postgres)
# KV_REST_API_URL="https://example.upstash.io"
# KV_REST_API_TOKEN="your_upstash_rest_token"

# ADMIN CREDENTIALS (Default fallback)
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="admin123"
